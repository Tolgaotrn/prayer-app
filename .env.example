# ── RevenueCat ──────────────────────────────────────────────────────────────
# iOS public SDK key — RevenueCat Dashboard → Apps → iOS → Public API Key
# Format: appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
REVENUECAT_API_KEY=appl_REPLACE_WITH_YOUR_IOS_PUBLIC_KEY

# ── PostHog ──────────────────────────────────────────────────────────────────
# Managed by the PostHog setup wizard (npx -y @posthog/wizard@latest).
# It writes EXPO_PUBLIC_POSTHOG_KEY + EXPO_PUBLIC_POSTHOG_HOST into .env.

# ── Apple (EAS build için — .env'e koymak yerine EAS Secret kullan) ──────────
# eas secret:create --scope project --name APPLE_TEAM_ID --value "XXXXXXXXXX"
# APPLE_TEAM_ID=REPLACE_WITH_YOUR_TEAM_ID
